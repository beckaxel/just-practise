<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Für den Code, den LibraryImport für P/Invoke erzeugt. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="SoundFlow" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\JustPractise.Core\JustPractise.Core.csproj" />
  </ItemGroup>

  <!--
    Die native Bibliothek für das Time-Stretching kommt aus native/bin/<rid>/ (dotnet run tools/setup.cs)
    und wird in die Ausgabe aller Projekte kopiert, die Audio verwenden. Fehlt sie, baut alles trotzdem;
    StretchVoice.IsAvailable meldet es dann zur Laufzeit.
  -->
  <PropertyGroup>
    <NativeOs Condition="$([MSBuild]::IsOSPlatform('Windows'))">win</NativeOs>
    <NativeOs Condition="$([MSBuild]::IsOSPlatform('OSX'))">osx</NativeOs>
    <NativeOs Condition="'$(NativeOs)' == ''">linux</NativeOs>
    <NativeArch>$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture.ToString().ToLowerInvariant())</NativeArch>
    <NativeBinDir>$(MSBuildThisFileDirectory)../../native/bin/$(NativeOs)-$(NativeArch)/</NativeBinDir>
  </PropertyGroup>
  <ItemGroup>
    <None Include="$(NativeBinDir)*jpstretch*" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>
</Project>
