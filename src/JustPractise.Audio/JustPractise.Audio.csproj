<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Für den Code, den LibraryImport für P/Invoke erzeugt. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="SoundFlow" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\JustPractise.Core\JustPractise.Core.csproj" />
  </ItemGroup>

  <!--
    Die nativen Bibliotheken für das Time-Stretching (jpstretch) und für M4A/AAC (jpaac mit den FFmpeg-Bibliotheken
    avformat, avcodec und avutil) kommen aus native/bin/<rid>/ (dotnet run tools/setup.cs) und werden in die Ausgabe
    aller Projekte kopiert, die Audio verwenden. Fehlen sie, baut alles trotzdem; StretchVoice.IsAvailable und
    AacDecoder.IsAvailable melden es dann zur Laufzeit.
  -->
  <PropertyGroup>
    <NativeOs Condition="$([MSBuild]::IsOSPlatform('Windows'))">win</NativeOs>
    <NativeOs Condition="$([MSBuild]::IsOSPlatform('OSX'))">osx</NativeOs>
    <NativeOs Condition="'$(NativeOs)' == ''">linux</NativeOs>
    <NativeArch>$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture.ToString().ToLowerInvariant())</NativeArch>
    <NativeBinDir>$(MSBuildThisFileDirectory)../../native/bin/$(NativeOs)-$(NativeArch)/</NativeBinDir>
  </PropertyGroup>
  <ItemGroup>
    <None Include="$(NativeBinDir)*jpstretch*;$(NativeBinDir)*jpaac*;$(NativeBinDir)*avformat*;$(NativeBinDir)*avcodec*;$(NativeBinDir)*avutil*"
          Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>
</Project>
