<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:p="using:JustPractise.App.Player"
             xmlns:c="using:JustPractise.App.Controls"
             xmlns:l="using:JustPractise.App.Localization"
             x:Class="JustPractise.App.Player.PlayerView"
             x:DataType="p:PlayerViewModel">
  <UserControl.Resources>
    <StreamGeometry x:Key="ToStartIcon">M6,5 H8 V19 H6 Z M19,5 L9,12 L19,19 Z</StreamGeometry>
    <!-- Lupe mit − bzw. +, Pfeile zwischen zwei Rändern für das ganze Stück -->
    <StreamGeometry x:Key="ZoomOutIcon">F0 M10,2 A7,7 0 1 1 10,16 A7,7 0 1 1 10,2 Z M10,4 A5,5 0 1 0 10,14 A5,5 0 1 0 10,4 Z M14.6,14 L16,12.6 L22,18.6 L20.6,20 Z M7,8 H13 V10 H7 Z</StreamGeometry>
    <StreamGeometry x:Key="ZoomInIcon">F0 M10,2 A7,7 0 1 1 10,16 A7,7 0 1 1 10,2 Z M10,4 A5,5 0 1 0 10,14 A5,5 0 1 0 10,4 Z M14.6,14 L16,12.6 L22,18.6 L20.6,20 Z M9,6 H11 V8 H13 V10 H11 V12 H9 V10 H7 V8 H9 Z</StreamGeometry>
    <StreamGeometry x:Key="ZoomAllIcon">M2,5 H4 V19 H2 Z M20,5 H22 V19 H20 Z M6,12 L10,8 V11 H14 V8 L18,12 L14,16 V13 H10 V16 Z</StreamGeometry>
  </UserControl.Resources>

  <UserControl.Styles>
    <Style Selector="Button.transport">
      <Setter Property="Width" Value="68" />
      <Setter Property="Height" Value="68" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="FontSize" Value="17" />
    </Style>
    <Style Selector="Button.transport PathIcon">
      <Setter Property="Width" Value="24" />
      <Setter Property="Height" Value="24" />
    </Style>
    <Style Selector="Button.transport.main">
      <Setter Property="Width" Value="84" />
      <Setter Property="Height" Value="68" />
    </Style>
    <Style Selector="Button.transport.main PathIcon">
      <Setter Property="Width" Value="32" />
      <Setter Property="Height" Value="32" />
    </Style>
    <Style Selector="Button.zoom">
      <Setter Property="Width" Value="52" />
      <Setter Property="Height" Value="52" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.zoom PathIcon">
      <Setter Property="Width" Value="22" />
      <Setter Property="Height" Value="22" />
    </Style>
    <Style Selector="p|WaveformControl">
      <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundBaseLowBrush}" />
      <Setter Property="WaveBrush" Value="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
      <Setter Property="PlayedBrush" Value="{DynamicResource SystemControlHighlightAccentBrush}" />
      <Setter Property="PositionBrush" Value="{DynamicResource SystemControlForegroundBaseHighBrush}" />
      <Setter Property="WindowBrush" Value="{DynamicResource WaveformWindowBrush}" />
    </Style>
    <Style Selector="TextBlock.label">
      <Setter Property="FontSize" Value="17" />
      <Setter Property="Opacity" Value="0.75" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </UserControl.Styles>

  <Panel>
    <TextBlock Text="{l:Tr player.empty}" Opacity="0.6" FontSize="18" IsVisible="{Binding !HasFile}" />

    <StackPanel IsVisible="{Binding HasFile}" Spacing="14">
      <!-- Stück und Datei -->
      <StackPanel>
        <TextBlock Text="{Binding File.PieceTitle, FallbackValue=''}" FontSize="30" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
        <TextBlock Text="{Binding File.FileName, FallbackValue=''}" FontSize="17" Opacity="0.65" TextTrimming="CharacterEllipsis" />
      </StackPanel>
      <TextBlock Classes="hint" Margin="0" Text="{l:Tr player.loading}" IsVisible="{Binding IsLoading}" />
      <TextBlock Classes="hint" Margin="0" Text="{l:Tr player.error}" IsVisible="{Binding HasError}" />

      <!--
        Wellenform über die ganze Breite: oben die Übersicht mit dem Ausschnitt, darunter der Ausschnitt groß. Ein Tipp
        springt an die Stelle, Ziehen verschiebt, zwei Finger oder Strg+Mausrad zoomen.
      -->
      <StackPanel IsEnabled="{Binding IsReady}" Spacing="6">
        <p:WaveformControl IsOverview="True" Height="36"
                           Peaks="{Binding Waveform}" Viewport="{Binding Viewport}" Position="{Binding PositionSeconds}" />
        <p:WaveformControl Height="150"
                           Peaks="{Binding Waveform}" Viewport="{Binding Viewport}" Position="{Binding PositionSeconds}" />
        <Grid ColumnDefinitions="*,Auto,*">
          <TextBlock Grid.Column="0" Text="{Binding PositionText}" FontSize="20" Opacity="0.8" VerticalAlignment="Center" />
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
            <Button Classes="zoom" Command="{Binding ZoomOutCommand}" IsEnabled="{Binding !Viewport.IsWhole}" ToolTip.Tip="{l:Tr player.zoomOut}">
              <PathIcon Data="{StaticResource ZoomOutIcon}" />
            </Button>
            <Button Classes="zoom" Command="{Binding ZoomAllCommand}" IsEnabled="{Binding !Viewport.IsWhole}" ToolTip.Tip="{l:Tr player.zoomAll}">
              <PathIcon Data="{StaticResource ZoomAllIcon}" />
            </Button>
            <Button Classes="zoom" Command="{Binding ZoomInCommand}" IsEnabled="{Binding Viewport.CanZoomIn}" ToolTip.Tip="{l:Tr player.zoomIn}">
              <PathIcon Data="{StaticResource ZoomInIcon}" />
            </Button>
          </StackPanel>
          <TextBlock Grid.Column="2" Text="{Binding DurationText}" FontSize="20" Opacity="0.8" HorizontalAlignment="Right" VerticalAlignment="Center" />
        </Grid>
      </StackPanel>

      <!-- Zum Anfang und Abspielen, im halben goldenen Schnitt (19,1 % : 80,9 %) -->
      <Grid ColumnDefinitions="191*,Auto,809*" IsEnabled="{Binding IsReady}">
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12">
          <Button Classes="transport" Command="{Binding ToStartCommand}" ToolTip.Tip="{l:Tr player.toStart}">
            <PathIcon Data="{StaticResource ToStartIcon}" />
          </Button>
          <Button Classes="transport main accent" Command="{Binding PlayPauseCommand}" ToolTip.Tip="{l:Tr player.playPause}">
            <Panel>
              <PathIcon Data="{StaticResource PlayIcon}" IsVisible="{Binding !IsPlaying}" />
              <PathIcon Data="{StaticResource PauseIcon}" IsVisible="{Binding IsPlaying}" />
            </Panel>
          </Button>
        </StackPanel>
      </Grid>

      <!-- Tempo und Lautstärke untereinander, mit Beschriftung; ein Tipp auf den Wert setzt zurück -->
      <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="16" RowSpacing="8" IsEnabled="{Binding IsReady}">
        <TextBlock Grid.Row="0" Grid.Column="0" Classes="label" Text="{l:Tr player.tempo}" />
        <c:StepSlider Grid.Row="0" Grid.Column="1"
                      Minimum="{x:Static p:PlayerViewModel.MinTempoPercent}"
                      Maximum="{x:Static p:PlayerViewModel.MaxTempoPercent}"
                      Step="1" LargeChange="5" ValueWidth="104"
                      Value="{Binding TempoPercent}"
                      ValueText="{Binding TempoPercent, StringFormat='{}{0:0} %'}"
                      ValueCommand="{Binding ResetTempoCommand}" ValueTip="{l:Tr player.resetTempo}"
                      DecreaseTip="{l:Tr player.slower}" IncreaseTip="{l:Tr player.faster}" />

        <TextBlock Grid.Row="1" Grid.Column="0" Classes="label" Text="{l:Tr player.volume}" />
        <c:StepSlider Grid.Row="1" Grid.Column="1"
                      Minimum="{x:Static p:PlayerViewModel.MinVolumeDb}"
                      Maximum="{x:Static p:PlayerViewModel.MaxVolumeDb}"
                      Step="0.5" LargeChange="3" ValueWidth="104"
                      Value="{Binding VolumeDb}"
                      ValueText="{Binding VolumeDb, StringFormat='{}{0:+0.0;−0.0;0.0} dB'}"
                      ValueCommand="{Binding ResetVolumeCommand}" ValueTip="{l:Tr player.resetVolume}"
                      DecreaseTip="{l:Tr player.quieter}" IncreaseTip="{l:Tr player.louder}" />
      </Grid>
    </StackPanel>
  </Panel>
</UserControl>
