<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:p="using:JustPractise.App.Player"
             xmlns:c="using:JustPractise.App.Controls"
             xmlns:l="using:JustPractise.App.Localization"
             x:Class="JustPractise.App.Player.PlayerView"
             x:DataType="p:PlayerViewModel">
  <UserControl.Resources>
    <StreamGeometry x:Key="PlayIcon">M8,5 L19,12 L8,19 Z</StreamGeometry>
    <StreamGeometry x:Key="PauseIcon">M6,5 H10 V19 H6 Z M14,5 H18 V19 H14 Z</StreamGeometry>
    <StreamGeometry x:Key="ToStartIcon">M6,5 H8 V19 H6 Z M19,5 L9,12 L19,19 Z</StreamGeometry>
  </UserControl.Resources>

  <UserControl.Styles>
    <Style Selector="Button.transport">
      <Setter Property="Width" Value="48" />
      <Setter Property="Height" Value="48" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="FontSize" Value="15" />
    </Style>
    <Style Selector="Button.transport PathIcon">
      <Setter Property="Width" Value="20" />
      <Setter Property="Height" Value="20" />
    </Style>
    <Style Selector="Button.transport.main">
      <Setter Property="Width" Value="60" />
      <Setter Property="Height" Value="56" />
    </Style>
    <Style Selector="Button.transport.main PathIcon">
      <Setter Property="Width" Value="26" />
      <Setter Property="Height" Value="26" />
    </Style>
    <Style Selector="c|StepSlider">
      <Setter Property="Width" Value="320" />
    </Style>
  </UserControl.Styles>

  <Panel>
    <TextBlock Text="{l:Tr player.empty}" Opacity="0.6" FontSize="16" IsVisible="{Binding !HasFile}" />

    <StackPanel IsVisible="{Binding HasFile}" Spacing="8">
      <!-- Stück und Datei -->
      <StackPanel>
        <TextBlock Text="{Binding File.PieceTitle, FallbackValue=''}" FontSize="22" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
        <TextBlock Text="{Binding File.FileName, FallbackValue=''}" FontSize="15" Opacity="0.65" TextTrimming="CharacterEllipsis" />
      </StackPanel>
      <TextBlock Classes="hint" Margin="0" Text="{l:Tr player.loading}" IsVisible="{Binding IsLoading}" />
      <TextBlock Classes="hint" Margin="0" Text="{l:Tr player.error}" IsVisible="{Binding HasError}" />

      <!-- Zeitleiste über die ganze Breite: ein Tipp springt an die Stelle -->
      <StackPanel IsEnabled="{Binding IsReady}">
        <Slider Minimum="0" Maximum="{Binding DurationSeconds}" Value="{Binding PositionSeconds}" />
        <Grid ColumnDefinitions="*,*">
          <TextBlock Grid.Column="0" Text="{Binding PositionText}" FontSize="16" Opacity="0.8" />
          <TextBlock Grid.Column="1" Text="{Binding DurationText}" FontSize="16" Opacity="0.8" HorizontalAlignment="Right" />
        </Grid>
      </StackPanel>

      <!-- Bedienung in einer Zeile; wird das Fenster schmal, bricht sie um -->
      <WrapPanel IsEnabled="{Binding IsReady}" ItemSpacing="20" LineSpacing="8">
        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <Button Classes="transport" Command="{Binding ToStartCommand}" ToolTip.Tip="{l:Tr player.toStart}">
            <PathIcon Data="{StaticResource ToStartIcon}" />
          </Button>
          <Button Classes="transport" Content="−5 s" Command="{Binding SeekBackCommand}" ToolTip.Tip="{l:Tr player.seekBack}" />
          <Button Classes="transport main accent" Command="{Binding PlayPauseCommand}" ToolTip.Tip="{l:Tr player.playPause}">
            <Panel>
              <PathIcon Data="{StaticResource PlayIcon}" IsVisible="{Binding !IsPlaying}" />
              <PathIcon Data="{StaticResource PauseIcon}" IsVisible="{Binding IsPlaying}" />
            </Panel>
          </Button>
          <Button Classes="transport" Content="+5 s" Command="{Binding SeekForwardCommand}" ToolTip.Tip="{l:Tr player.seekForward}" />
        </StackPanel>

        <!-- Tempo und Lautstärke; ein Tipp auf den Wert setzt zurück -->
        <c:StepSlider VerticalAlignment="Center"
                      Icon="{StaticResource TempoIcon}" Label="{l:Tr player.tempo}"
                      Minimum="{x:Static p:PlayerViewModel.MinTempoPercent}"
                      Maximum="{x:Static p:PlayerViewModel.MaxTempoPercent}"
                      Step="1" LargeChange="5"
                      Value="{Binding TempoPercent}"
                      ValueText="{Binding TempoPercent, StringFormat='{}{0:0} %'}"
                      ValueCommand="{Binding ResetTempoCommand}" ValueTip="{l:Tr player.resetTempo}"
                      DecreaseTip="{l:Tr player.slower}" IncreaseTip="{l:Tr player.faster}" />
        <c:StepSlider VerticalAlignment="Center"
                      Icon="{StaticResource VolumeIcon}" Label="{l:Tr player.volume}"
                      Minimum="{x:Static p:PlayerViewModel.MinVolumeDb}"
                      Maximum="{x:Static p:PlayerViewModel.MaxVolumeDb}"
                      Step="0.5" LargeChange="3" ValueWidth="92"
                      Value="{Binding VolumeDb}"
                      ValueText="{Binding VolumeDb, StringFormat='{}{0:+0.0;−0.0;0.0} dB'}"
                      ValueCommand="{Binding ResetVolumeCommand}" ValueTip="{l:Tr player.resetVolume}"
                      DecreaseTip="{l:Tr player.quieter}" IncreaseTip="{l:Tr player.louder}" />
      </WrapPanel>
    </StackPanel>
  </Panel>
</UserControl>
