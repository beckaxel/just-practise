<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>just-practise</AssemblyName>
    <RootNamespace>JustPractise.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Für den Code, den LibraryImport für P/Invoke erzeugt. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Vorläufiges Icon (Kleinbuchstaben jp); PNG für Fenster und Linux, ICO für die exe und das Setup unter Windows. -->
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- Prüfpunkt 9: startet gut 40 % schneller, das Paket wird gezippt rund 7 MB größer. Wirkt nur bei dotnet publish. -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <!-- Prüfpunkt 1: Workstation-GC mit Hintergrund-GC; Server-GC und GC ohne Hintergrund halten den Audio-Callback zu lange an. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <!--
      Unter Linux die GC mit Segmenten (libclrgc.so, Teil der .NET-Runtime) statt mit Regionen: Ihre blockierenden
      kleinen GCs halten den Audio-Callback nur halb so lange an (Gen1 10 statt 28 ms, siehe docs/technologie.md, Prüfpunkt 1).
    -->
    <UseSegmentsGc Condition="'$(RuntimeIdentifier)' == '' And $([MSBuild]::IsOSPlatform('Linux'))">true</UseSegmentsGc>
    <UseSegmentsGc Condition="$(RuntimeIdentifier.StartsWith('linux'))">true</UseSegmentsGc>
  </PropertyGroup>
  <ItemGroup Condition="'$(UseSegmentsGc)' == 'true'">
    <RuntimeHostConfigurationOption Include="System.GC.Name" Value="libclrgc.so" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="MessageFormat" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Tmds.DBus.Protocol" />
    <PackageReference Include="Velopack" />
  </ItemGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets\icon.png" />
    <EmbeddedResource Include="Localization\*.json" LogicalName="Localization.%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\JustPractise.Core\JustPractise.Core.csproj" />
    <ProjectReference Include="..\JustPractise.Audio\JustPractise.Audio.csproj" />
    <ProjectReference Include="..\JustPractise.Storage\JustPractise.Storage.csproj" />
  </ItemGroup>

  <!--
    SkiaSharp und HarfBuzz liefern unter Windows Debug-Symbole ihrer nativen Bibliotheken mit (rund 100 MB).
    Symbole aus NuGet-Paketen kommen deshalb nicht ins Paket; die eigenen bleiben für Zeilennummern in Fehlerberichten.
  -->
  <Target Name="RemovePackageSymbolsFromPublish" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Extension)' == '.pdb' And '%(ResolvedFileToPublish.NuGetPackageId)' != ''" />
    </ItemGroup>
  </Target>
</Project>
