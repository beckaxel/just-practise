<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:m="using:JustPractise.App.Metronome"
             xmlns:l="using:JustPractise.App.Localization"
             x:Class="JustPractise.App.Metronome.MetronomeToolView"
             x:DataType="m:MetronomeViewModel">
  <!--
    Das Metronom in der Werkzeugleiste: nur das Nötigste, aus Abstand lesbar. Ein Tipp auf Tempo oder Schlaganzeige
    öffnet die Einstellungen (OpenCommand), Start/Stopp liegt direkt daneben.
  -->
  <UserControl.Styles>
    <Style Selector="Ellipse.beat">
      <Setter Property="Width" Value="14" />
      <Setter Property="Height" Value="14" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Fill" Value="{DynamicResource SystemControlForegroundBaseLowBrush}" />
    </Style>
    <Style Selector="Ellipse.beat.accent">
      <Setter Property="Width" Value="22" />
      <Setter Property="Height" Value="22" />
    </Style>
    <Style Selector="Ellipse.beat.current">
      <Setter Property="Fill" Value="{DynamicResource SystemAccentColor}" />
    </Style>
  </UserControl.Styles>

  <StackPanel Orientation="Horizontal" Spacing="8">
    <Button x:Name="OpenButton" Classes="flat" MinHeight="52" Padding="10,4"
            Command="{Binding $parent[m:MetronomeToolView].OpenCommand}"
            ToolTip.Tip="{l:Tr metronome.open}">
      <StackPanel Orientation="Horizontal" Spacing="12">
        <PathIcon Data="{StaticResource TempoIcon}" Width="22" Height="22" Opacity="0.8" />
        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
          <TextBlock Text="{Binding Bpm}" FontSize="26" FontWeight="SemiBold" VerticalAlignment="Center" />
          <TextBlock Text="BPM" FontSize="14" Opacity="0.65" VerticalAlignment="Bottom" Margin="0,0,0,4" />
        </StackPanel>
        <ItemsControl ItemsSource="{Binding Beats}" VerticalAlignment="Center">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" Spacing="8" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="m:BeatDot">
              <Ellipse Classes="beat" Classes.accent="{Binding IsAccent}" Classes.current="{Binding IsCurrent}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Button>
    <Button x:Name="StartStopButton" Classes="accent" MinWidth="96" Height="48" FontSize="16" VerticalAlignment="Center"
            HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
            Command="{Binding StartStopCommand}">
      <Panel>
        <TextBlock Text="{l:Tr metronome.start}" IsVisible="{Binding !IsRunning}" />
        <TextBlock Text="{l:Tr metronome.stop}" IsVisible="{Binding IsRunning}" />
      </Panel>
    </Button>
  </StackPanel>
</UserControl>
