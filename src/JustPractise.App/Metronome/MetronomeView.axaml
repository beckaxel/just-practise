<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:m="using:JustPractise.App.Metronome"
             xmlns:c="using:JustPractise.App.Controls"
             xmlns:l="using:JustPractise.App.Localization"
             x:Class="JustPractise.App.Metronome.MetronomeView"
             x:DataType="m:MetronomeViewModel">
  <UserControl.Styles>
    <Style Selector="Button.meter">
      <Setter Property="MinWidth" Value="56" />
      <Setter Property="Height" Value="44" />
      <Setter Property="FontSize" Value="16" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="c|StepSlider">
      <Setter Property="Width" Value="320" />
    </Style>

    <!-- Schlaganzeige: die Eins ist größer, der aktuelle Schlag leuchtet -->
    <Style Selector="Ellipse.beat">
      <Setter Property="Width" Value="16" />
      <Setter Property="Height" Value="16" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Fill" Value="{DynamicResource SystemControlForegroundBaseLowBrush}" />
    </Style>
    <Style Selector="Ellipse.beat.accent">
      <Setter Property="Width" Value="24" />
      <Setter Property="Height" Value="24" />
    </Style>
    <Style Selector="Ellipse.beat.current">
      <Setter Property="Fill" Value="{DynamicResource SystemAccentColor}" />
    </Style>
  </UserControl.Styles>

  <!-- Breit und flach: alles in einer Zeile, die bei schmalem Fenster umbricht -->
  <WrapPanel ItemSpacing="20" LineSpacing="8">
    <!-- Start/Stopp mit Schlaganzeige -->
    <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
      <Button Classes="accent" MinWidth="96" Height="48" FontSize="16"
              HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
              Command="{Binding StartStopCommand}">
        <Panel>
          <TextBlock Text="{l:Tr metronome.start}" IsVisible="{Binding !IsRunning}" />
          <TextBlock Text="{l:Tr metronome.stop}" IsVisible="{Binding IsRunning}" />
        </Panel>
      </Button>
      <ItemsControl ItemsSource="{Binding Beats}" VerticalAlignment="Center">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Orientation="Horizontal" Spacing="10" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="m:BeatDot">
            <Ellipse Classes="beat" Classes.accent="{Binding IsAccent}" Classes.current="{Binding IsCurrent}" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>

    <!--
      Tempo wie im Player; ein Tipp auf den Wert öffnet die direkte Eingabe.
      30 bis 250 wie MetronomeViewModel.MinBpm/MaxBpm (int, hier wird double gebraucht), das außerdem begrenzt.
    -->
    <c:StepSlider VerticalAlignment="Center"
                  Icon="{StaticResource TempoIcon}" Label="{l:Tr metronome.tempo}"
                  Minimum="30"
                  Maximum="250"
                  Step="1" LargeChange="10" ValueWidth="104"
                  Value="{Binding Bpm}"
                  ValueText="{Binding Bpm, StringFormat='{}{0} BPM'}"
                  ValueTip="{l:Tr metronome.enterTempo}"
                  DecreaseTip="{l:Tr metronome.slower}" IncreaseTip="{l:Tr metronome.faster}">
      <c:StepSlider.ValueFlyout>
        <Flyout Placement="Bottom">
          <NumericUpDown x:DataType="m:MetronomeViewModel" Width="180" FontSize="22"
                         Minimum="30"
                         Maximum="250"
                         Increment="1" FormatString="0" ClipValueToMinMax="True"
                         Value="{Binding BpmInput}" />
        </Flyout>
      </c:StepSlider.ValueFlyout>
    </c:StepSlider>

    <!-- Taktart -->
    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" ToolTip.Tip="{l:Tr metronome.meter}">
      <Button Classes="meter" Classes.accent="{Binding IsThreeFour}" Content="3/4" Command="{Binding UseThreeFourCommand}" />
      <Button Classes="meter" Classes.accent="{Binding IsFourFour}" Content="4/4" Command="{Binding UseFourFourCommand}" />
    </StackPanel>

    <!-- Lautstärke wie im Player; ein Tipp auf den Wert setzt zurück -->
    <c:StepSlider VerticalAlignment="Center"
                  Icon="{StaticResource VolumeIcon}" Label="{l:Tr metronome.volume}"
                  Minimum="{x:Static m:MetronomeViewModel.MinVolumeDb}"
                  Maximum="{x:Static m:MetronomeViewModel.MaxVolumeDb}"
                  Step="0.5" LargeChange="3" ValueWidth="92"
                  Value="{Binding VolumeDb}"
                  ValueText="{Binding VolumeDb, StringFormat='{}{0:+0.0;−0.0;0.0} dB'}"
                  ValueCommand="{Binding ResetVolumeCommand}" ValueTip="{l:Tr metronome.resetVolume}"
                  DecreaseTip="{l:Tr metronome.quieter}" IncreaseTip="{l:Tr metronome.louder}" />
  </WrapPanel>
</UserControl>
