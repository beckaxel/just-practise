<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:m="using:JustPractise.App.Metronome"
             xmlns:c="using:JustPractise.App.Controls"
             xmlns:l="using:JustPractise.App.Localization"
             x:Class="JustPractise.App.Metronome.MetronomeView"
             x:DataType="m:MetronomeViewModel">
  <!-- Die Einstellungen des Metronoms, aufgeklappt aus der Werkzeugleiste: Tempo, Taktart, Lautstärke -->
  <UserControl.Styles>
    <Style Selector="Button.choice">
      <Setter Property="MinWidth" Value="60" />
      <Setter Property="Height" Value="48" />
      <Setter Property="FontSize" Value="17" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="RepeatButton.step">
      <Setter Property="Width" Value="48" />
      <Setter Property="Height" Value="48" />
      <Setter Property="FontSize" Value="22" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.label">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Opacity" Value="0.7" />
      <Setter Property="Margin" Value="0,0,0,2" />
    </Style>
  </UserControl.Styles>

  <StackPanel Spacing="16" Width="560">
    <!-- Schläge pro Takt; der erste ist automatisch betont -->
    <StackPanel Spacing="6">
      <TextBlock Classes="label" Text="{l:Tr metronome.beats}" />
      <StackPanel Orientation="Horizontal" Spacing="8">
        <RepeatButton Classes="step" Content="−" Command="{Binding FewerBeatsCommand}" ToolTip.Tip="{l:Tr metronome.fewerBeats}" />
        <TextBlock Text="{Binding Meter.Beats}" FontSize="22" FontWeight="SemiBold" MinWidth="40"
                   TextAlignment="Center" VerticalAlignment="Center" />
        <RepeatButton Classes="step" Content="+" Command="{Binding MoreBeatsCommand}" ToolTip.Tip="{l:Tr metronome.moreBeats}" />
      </StackPanel>
    </StackPanel>

    <!-- Tempo: Voreinstellungen, darunter der Regler wie im Player und daneben ein Feld zur direkten Eingabe -->
    <StackPanel Spacing="6">
      <TextBlock Classes="label" Text="{l:Tr metronome.tempo}" />
      <ItemsControl ItemsSource="{Binding TempoPresets}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Orientation="Horizontal" Spacing="8" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="m:NumberChoice">
            <Button Classes="choice" Classes.accent="{Binding IsSelected}" Content="{Binding Label}"
                    Command="{Binding $parent[UserControl].((m:MetronomeViewModel)DataContext).UseTempoPresetCommand}"
                    CommandParameter="{Binding}" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <!-- 30 bis 250 wie MetronomeViewModel.MinBpm/MaxBpm (int, hier wird double gebraucht), das außerdem begrenzt -->
      <Grid ColumnDefinitions="*,150" ColumnSpacing="8">
        <c:StepSlider Minimum="30" Maximum="250" Step="1" LargeChange="10" ShowValue="False"
                      Value="{Binding Bpm}"
                      DecreaseTip="{l:Tr metronome.slower}" IncreaseTip="{l:Tr metronome.faster}" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" HorizontalAlignment="Left">
          <NumericUpDown Width="96" Height="44" FontSize="18" ShowButtonSpinner="False"
                         HorizontalContentAlignment="Right" VerticalContentAlignment="Center"
                         Minimum="30" Maximum="250" Increment="1" FormatString="0" ClipValueToMinMax="True"
                         Value="{Binding BpmInput}" ToolTip.Tip="{l:Tr metronome.enterTempo}" />
          <TextBlock Text="BPM" FontSize="16" Opacity="0.7" VerticalAlignment="Center" />
        </StackPanel>
      </Grid>
    </StackPanel>

    <!-- Lautstärke wie im Player; ein Tipp auf den Wert setzt zurück -->
    <StackPanel Spacing="6">
      <TextBlock Classes="label" Text="{l:Tr metronome.volume}" />
      <!-- Gleicher Aufbau wie beim Tempo, damit beide Regler genau untereinander stehen -->
      <Grid ColumnDefinitions="*,150" ColumnSpacing="8">
        <c:StepSlider Minimum="{x:Static m:MetronomeViewModel.MinVolumeDb}"
                      Maximum="{x:Static m:MetronomeViewModel.MaxVolumeDb}"
                      Step="0.5" LargeChange="3" ShowValue="False"
                      Value="{Binding VolumeDb}"
                      DecreaseTip="{l:Tr metronome.quieter}" IncreaseTip="{l:Tr metronome.louder}" />
        <Button Grid.Column="1" Classes="flat" HorizontalAlignment="Left" MinWidth="104" MinHeight="44"
                FontSize="17" FontWeight="SemiBold"
                Content="{Binding VolumeDb, StringFormat='{}{0:+0.0;−0.0;0.0} dB'}"
                Command="{Binding ResetVolumeCommand}" ToolTip.Tip="{l:Tr metronome.resetVolume}" />
      </Grid>
    </StackPanel>
  </StackPanel>
</UserControl>
