<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fb="using:JustPractise.App.FileBrowser"
             x:Class="JustPractise.App.FileBrowser.BreadcrumbBar"
             x:DataType="fb:FileBrowserViewModel">
  <!-- Die Pfadzeile: wo die gewählte Stelle in der Bibliothek liegt. Ein Tipp auf ein Glied klappt den Weg dorthin auf. -->
  <UserControl.Styles>
    <Style Selector="Button.crumb">
      <Setter Property="MinHeight" Value="44" />
      <Setter Property="Padding" Value="8,2" />
      <Setter Property="FontSize" Value="17" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.crumb.file">
      <Setter Property="Foreground" Value="{DynamicResource LibraryFileBrush}" />
    </Style>
  </UserControl.Styles>

  <ItemsControl ItemsSource="{Binding Breadcrumbs}" VerticalAlignment="Center">
    <ItemsControl.ItemsPanel>
      <ItemsPanelTemplate>
        <WrapPanel />
      </ItemsPanelTemplate>
    </ItemsControl.ItemsPanel>
    <ItemsControl.ItemTemplate>
      <DataTemplate x:DataType="fb:BreadcrumbItem">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="›" FontSize="20" Opacity="0.5" VerticalAlignment="Center" Margin="2,0" IsVisible="{Binding !IsFirst}" />
          <Button Classes="flat crumb" Classes.file="{Binding File, Converter={x:Static ObjectConverters.IsNotNull}}" Content="{Binding Name}"
                  Command="{Binding $parent[UserControl].((fb:FileBrowserViewModel)DataContext).OpenBreadcrumbCommand}"
                  CommandParameter="{Binding}" />
        </StackPanel>
      </DataTemplate>
    </ItemsControl.ItemTemplate>
  </ItemsControl>
</UserControl>
