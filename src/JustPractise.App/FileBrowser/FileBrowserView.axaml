<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fb="using:JustPractise.App.FileBrowser"
             xmlns:l="using:JustPractise.App.Localization"
             x:Class="JustPractise.App.FileBrowser.FileBrowserView"
             x:DataType="fb:FileBrowserViewModel">
  <UserControl.Resources>
    <StreamGeometry x:Key="FolderIcon">M2,5 H9 L11,7 H22 V19 H2 Z</StreamGeometry>
    <StreamGeometry x:Key="ChevronIcon">M9,5 L16,12 L9,19 L7.6,17.6 L13.2,12 L7.6,6.4 Z</StreamGeometry>
    <StreamGeometry x:Key="PlusIcon">M11,4 H13 V11 H20 V13 H13 V20 H11 V13 H4 V11 H11 Z</StreamGeometry>
    <StreamGeometry x:Key="RefreshIcon">M12,4 A8,8 0 1 0 20,12 H18 A6,6 0 1 1 12,6 V9 L16,5 L12,1 Z</StreamGeometry>
  </UserControl.Resources>

  <UserControl.Styles>
    <Style Selector="Button.row">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Padding" Value="6,4" />
    </Style>
    <Style Selector="Button.row.selected">
      <Setter Property="Background" Value="{DynamicResource SystemControlHighlightListAccentLowBrush}" />
    </Style>
    <Style Selector="ToggleButton.expander PathIcon">
      <Setter Property="RenderTransform" Value="rotate(0deg)" />
    </Style>
    <Style Selector="ToggleButton.expander:checked PathIcon">
      <Setter Property="RenderTransform" Value="rotate(90deg)" />
    </Style>
    <Style Selector="ToggleButton.expander:checked">
      <Setter Property="Background" Value="Transparent" />
    </Style>
  </UserControl.Styles>

  <DockPanel>
    <!-- Pfadzeile mit Knöpfen -->
    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,4">
      <ItemsControl Grid.Column="0" ItemsSource="{Binding Breadcrumbs}" VerticalAlignment="Center">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="fb:BreadcrumbItem">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="›" Opacity="0.5" VerticalAlignment="Center" Margin="2,0" IsVisible="{Binding !IsTop}" />
              <Button Classes="flat"
                      Command="{Binding $parent[UserControl].((fb:FileBrowserViewModel)DataContext).OpenBreadcrumbCommand}"
                      CommandParameter="{Binding}">
                <Panel>
                  <TextBlock Text="{l:Tr browser.musicFolders}" IsVisible="{Binding IsTop}" />
                  <TextBlock Text="{Binding Name}" IsVisible="{Binding !IsTop}" />
                </Panel>
              </Button>
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <Button Grid.Column="1" Classes="flat" VerticalAlignment="Top"
              Command="{Binding AddMusicFolderCommand}"
              IsVisible="{Binding IsTop}"
              ToolTip.Tip="{l:Tr browser.addFolder}">
        <PathIcon Classes="small" Data="{StaticResource PlusIcon}" />
      </Button>
      <Button Grid.Column="2" Classes="flat" VerticalAlignment="Top"
              Command="{Binding RefreshCommand}"
              ToolTip.Tip="{l:Tr browser.refresh}">
        <PathIcon Classes="small" Data="{StaticResource RefreshIcon}" />
      </Button>
    </Grid>

    <ProgressBar DockPanel.Dock="Top" IsIndeterminate="True" IsVisible="{Binding IsLoading}" MinHeight="2" Height="2" />

    <ScrollViewer>
      <StackPanel>
        <!-- Hinweise -->
        <StackPanel IsVisible="{Binding HasNoMusicFolders}" Spacing="8">
          <TextBlock Classes="hint" Text="{l:Tr browser.noFolders}" />
          <Button Content="{l:Tr browser.chooseFolder}" Command="{Binding AddMusicFolderCommand}" Margin="6,0" />
        </StackPanel>
        <TextBlock Classes="hint" Text="{l:Tr browser.unreachable}" IsVisible="{Binding IsUnreachable}" />
        <TextBlock Classes="hint" Text="{l:Tr browser.empty}" IsVisible="{Binding IsEmpty}" />

        <!-- Unterordner bzw. Musikordner -->
        <ItemsControl ItemsSource="{Binding Folders}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="fb:FolderItem">
              <Button Classes="row"
                      Command="{Binding $parent[UserControl].((fb:FileBrowserViewModel)DataContext).OpenFolderCommand}"
                      CommandParameter="{Binding}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <PathIcon Classes="small" Data="{StaticResource FolderIcon}" Opacity="0.7" />
                  <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{l:Tr browser.notReachable}" Opacity="0.6" IsVisible="{Binding !IsReachable}" />
                </StackPanel>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Stücke, mit mehreren Dateien aufklappbar -->
        <ItemsControl ItemsSource="{Binding Pieces}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="fb:PieceItem">
              <StackPanel>
                <Grid ColumnDefinitions="24,*">
                  <ToggleButton Grid.Column="0" Classes="flat expander"
                                IsChecked="{Binding IsExpanded}"
                                IsVisible="{Binding HasSeveralFiles}"
                                VerticalAlignment="Center">
                    <PathIcon Width="10" Height="10" Data="{StaticResource ChevronIcon}" RenderTransformOrigin="50%,50%" />
                  </ToggleButton>
                  <Button Grid.Column="1" Classes="row" Classes.selected="{Binding IsSelected}"
                          Command="{Binding $parent[UserControl].((fb:FileBrowserViewModel)DataContext).SelectPieceCommand}"
                          CommandParameter="{Binding}">
                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                  </Button>
                </Grid>
                <ItemsControl ItemsSource="{Binding Files}" IsVisible="{Binding IsExpanded}" Margin="24,0,0,0">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="fb:FileItem">
                      <Button Classes="row" Classes.selected="{Binding IsSelected}"
                              Command="{Binding $parent[UserControl].((fb:FileBrowserViewModel)DataContext).SelectFileCommand}"
                              CommandParameter="{Binding}">
                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" Opacity="0.85" />
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
