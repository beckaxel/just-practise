<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fb="using:JustPractise.App.FileBrowser"
             xmlns:l="using:JustPractise.App.Localization"
             x:Class="JustPractise.App.FileBrowser.FileBrowserView"
             x:DataType="fb:FileBrowserViewModel">
  <UserControl.Resources>
    <StreamGeometry x:Key="FolderIcon">M2,5 H9 L11,7 H22 V19 H2 Z</StreamGeometry>
    <!-- Zwei Achtelnoten mit Balken -->
    <StreamGeometry x:Key="NotesIcon">F1 M8.5,4 L20,1 V4.5 L10,7.1 V17.5 H8.5 Z M10,17.5 A3.5,2.8 0 1 1 3,17.5 A3.5,2.8 0 1 1 10,17.5 Z M18.5,2 H20 V15.5 H18.5 Z M20,15.5 A3.5,2.8 0 1 1 13,15.5 A3.5,2.8 0 1 1 20,15.5 Z</StreamGeometry>
    <StreamGeometry x:Key="ChevronIcon">M9,5 L16,12 L9,19 L7.6,17.6 L13.2,12 L7.6,6.4 Z</StreamGeometry>
    <StreamGeometry x:Key="PlusIcon">M11,4 H13 V11 H20 V13 H13 V20 H11 V13 H4 V11 H11 Z</StreamGeometry>
    <StreamGeometry x:Key="RemoveIcon">M6.4,5 L12,10.6 L17.6,5 L19,6.4 L13.4,12 L19,17.6 L17.6,19 L12,13.4 L6.4,19 L5,17.6 L10.6,12 L5,6.4 Z</StreamGeometry>
    <StreamGeometry x:Key="RefreshIcon">M12,4 A8,8 0 1 0 20,12 H18 A6,6 0 1 1 12,6 V9 L16,5 L12,1 Z</StreamGeometry>
  </UserControl.Resources>

  <UserControl.Styles>
    <!-- Zeilen groß genug für Finger und aus Abstand lesbar -->
    <Style Selector="Button.row">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="MinHeight" Value="44" />
      <Setter Property="Padding" Value="4,0,8,0" />
      <Setter Property="FontSize" Value="16" />
      <Setter Property="CornerRadius" Value="4" />
    </Style>
    <Style Selector="Button.row.selected">
      <Setter Property="Background" Value="{DynamicResource SystemControlHighlightListAccentLowBrush}" />
    </Style>
    <Style Selector="Button.row PathIcon.kind">
      <Setter Property="Width" Value="20" />
      <Setter Property="Height" Value="20" />
    </Style>
    <Style Selector="Button.row.folder TextBlock.name">
      <Setter Property="Foreground" Value="{DynamicResource LibraryFolderBrush}" />
    </Style>
    <Style Selector="Button.row.folder PathIcon.kind">
      <Setter Property="Foreground" Value="{DynamicResource LibraryFolderBrush}" />
    </Style>
    <Style Selector="Button.row.piece TextBlock.name">
      <Setter Property="Foreground" Value="{DynamicResource LibraryPieceBrush}" />
    </Style>
    <Style Selector="Button.row.piece PathIcon.kind">
      <Setter Property="Foreground" Value="{DynamicResource LibraryPieceBrush}" />
    </Style>
    <Style Selector="Button.row.file TextBlock.name">
      <Setter Property="Foreground" Value="{DynamicResource LibraryFileBrush}" />
    </Style>
    <Style Selector="Button.row.file PathIcon.kind">
      <Setter Property="Foreground" Value="{DynamicResource LibraryFileBrush}" />
    </Style>
    <Style Selector="PathIcon.chevron">
      <Setter Property="Width" Value="14" />
      <Setter Property="Height" Value="14" />
      <Setter Property="Opacity" Value="0.7" />
      <Setter Property="RenderTransform" Value="rotate(0deg)" />
    </Style>
    <Style Selector="PathIcon.chevron.expanded">
      <Setter Property="RenderTransform" Value="rotate(90deg)" />
    </Style>
    <Style Selector="Button.tool">
      <Setter Property="Width" Value="44" />
      <Setter Property="Height" Value="44" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.tool PathIcon">
      <Setter Property="Width" Value="18" />
      <Setter Property="Height" Value="18" />
    </Style>
    <Style Selector="Button.crumb">
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="Padding" Value="6,2" />
      <Setter Property="FontSize" Value="14" />
    </Style>
  </UserControl.Styles>

  <DockPanel>
    <!-- Pfadzeile zur gewählten Stelle, daneben Hinzufügen und Aktualisieren -->
    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,4">
      <ItemsControl Grid.Column="0" ItemsSource="{Binding Breadcrumbs}" VerticalAlignment="Center">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="fb:BreadcrumbItem">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="›" Opacity="0.5" VerticalAlignment="Center" Margin="1,0" IsVisible="{Binding !IsFirst}" />
              <Button Classes="flat crumb" Content="{Binding Name}"
                      Command="{Binding $parent[UserControl].((fb:FileBrowserViewModel)DataContext).OpenBreadcrumbCommand}"
                      CommandParameter="{Binding}" />
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <Button Grid.Column="1" Classes="flat tool" VerticalAlignment="Top"
              Command="{Binding AddMusicFolderCommand}"
              ToolTip.Tip="{l:Tr browser.addFolder}">
        <PathIcon Data="{StaticResource PlusIcon}" />
      </Button>
      <Button Grid.Column="2" Classes="flat tool" VerticalAlignment="Top"
              Command="{Binding RefreshCommand}"
              ToolTip.Tip="{l:Tr browser.refresh}">
        <PathIcon Data="{StaticResource RefreshIcon}" />
      </Button>
    </Grid>

    <ProgressBar DockPanel.Dock="Top" IsIndeterminate="True" IsVisible="{Binding IsLoading}" MinHeight="2" Height="2" />

    <!-- Erster Start: noch kein Musikordner -->
    <StackPanel DockPanel.Dock="Top" IsVisible="{Binding HasNoMusicFolders}" Spacing="8">
      <TextBlock Classes="hint" FontSize="15" Text="{l:Tr browser.noFolders}" />
      <Button Content="{l:Tr browser.chooseFolder}" Command="{Binding AddMusicFolderCommand}" Margin="6,0" MinHeight="44" />
    </StackPanel>

    <!-- Der Baum: Ordner, virtuelle Stücke (aufklappbar) und abspielbare Dateien, eingerückt nach Tiefe -->
    <ScrollViewer x:Name="Scroller" HorizontalScrollBarVisibility="Disabled">
      <ItemsControl x:Name="Library" ItemsSource="{Binding Rows}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <VirtualizingStackPanel />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="fb:LibraryRow">
            <Button Classes="row"
                    Classes.folder="{Binding IsFolder}" Classes.piece="{Binding IsPiece}" Classes.file="{Binding IsFile}"
                    Classes.selected="{Binding IsSelected}"
                    Command="{Binding $parent[UserControl].((fb:FileBrowserViewModel)DataContext).ActivateCommand}"
                    CommandParameter="{Binding}">
              <Grid ColumnDefinitions="Auto,24,Auto,*,Auto" ColumnSpacing="6">
                <Border Grid.Column="0" Width="{Binding Indent}" />
                <PathIcon Grid.Column="1" Classes="chevron" Classes.expanded="{Binding IsExpanded}"
                          Data="{StaticResource ChevronIcon}" RenderTransformOrigin="50%,50%"
                          IsVisible="{Binding HasChildren}" />
                <Panel Grid.Column="2" VerticalAlignment="Center">
                  <PathIcon Classes="kind" Data="{StaticResource FolderIcon}" IsVisible="{Binding IsFolder}" />
                  <PathIcon Classes="kind" Data="{StaticResource NotesIcon}" IsVisible="{Binding !IsFolder}" />
                </Panel>
                <DockPanel Grid.Column="3" VerticalAlignment="Center">
                  <TextBlock DockPanel.Dock="Right" Margin="6,0,0,0" Text="{l:Tr browser.notReachable}" Opacity="0.6"
                             IsVisible="{Binding !IsReachable}" />
                  <TextBlock Classes="name" Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}" />
                </DockPanel>
                <!-- Musikordner entfernen (mit Rückfrage) -->
                <Button Grid.Column="4" Classes="flat tool" IsVisible="{Binding IsMusicFolder}"
                        Command="{Binding $parent[UserControl].((fb:FileBrowserViewModel)DataContext).RemoveMusicFolderCommand}"
                        CommandParameter="{Binding Key}"
                        ToolTip.Tip="{l:Tr removeFolder.removeTip}">
                  <PathIcon Data="{StaticResource RemoveIcon}" Width="14" Height="14" Opacity="0.6" />
                </Button>
              </Grid>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </DockPanel>
</UserControl>
