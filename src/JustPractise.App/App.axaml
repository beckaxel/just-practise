<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="JustPractise.App.App"
             RequestedThemeVariant="Default">
  <Application.Resources>
    <ResourceDictionary>
      <!-- Symbol des Metronoms im Werkzeugbereich -->
      <StreamGeometry x:Key="TempoIcon">M9,2 H15 L20,22 H4 Z M10.5,4 H13.5 L17.3,20 H6.7 Z M11.2,18 L15.5,6.5 L16.6,7 L12.6,18.5 Z</StreamGeometry>

      <!--
        Farben der Bibliothek: Ordner in der Textfarbe des Schemas (weiß bzw. schwarz), virtuelle Stücke leicht
        bläulich, abspielbare Stücke leicht grünlich. Je Schema so gewählt, dass sie gut lesbar bleiben.
      -->
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="LibraryFolderBrush" Color="#000000" />
          <SolidColorBrush x:Key="LibraryPieceBrush" Color="#1D4F8C" />
          <SolidColorBrush x:Key="LibraryFileBrush" Color="#1F6B3A" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="LibraryFolderBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="LibraryPieceBrush" Color="#A9CBF5" />
          <SolidColorBrush x:Key="LibraryFileBrush" Color="#B4E6BF" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />

    <!-- Gemeinsame Stile aller Bereiche -->
    <!-- Text in Knöpfen immer mittig, auch wenn der Knopf für den Finger größer ist als die Schrift -->
    <Style Selector="Button, RepeatButton, ToggleButton">
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.flat, ToggleButton.flat">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="4" />
    </Style>
    <Style Selector="PathIcon.small">
      <Setter Property="Width" Value="14" />
      <Setter Property="Height" Value="14" />
    </Style>
    <Style Selector="TextBlock.hint">
      <Setter Property="Opacity" Value="0.6" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="6,4" />
    </Style>
  </Application.Styles>
</Application>
