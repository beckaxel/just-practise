<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="JustPractise.App.App"
             RequestedThemeVariant="Default">
  <Application.Resources>
    <ResourceDictionary>
      <!-- Symbol des Metronoms im Werkzeugbereich -->
      <!-- Abspielen, Pause und Neustart: gleich in Player, Metronom und Übetimer -->
    <StreamGeometry x:Key="PlayIcon">M8,5 L19,12 L8,19 Z</StreamGeometry>
    <StreamGeometry x:Key="PauseIcon">M6,5 H10 V19 H6 Z M14,5 H18 V19 H14 Z</StreamGeometry>
    <StreamGeometry x:Key="RestartIcon">M12,4 A8,8 0 1 0 20,12 H18 A6,6 0 1 1 12,6 V9 L16,5 L12,1 Z</StreamGeometry>
    <!-- Stimmgabel für das Stimmgerät, Mikrofon für seinen An/Aus-Knopf -->
    <StreamGeometry x:Key="TuningForkIcon">M8,2 H10 V11 A2,2 0 0 0 14,11 V2 H16 V11 A4,4 0 0 1 13,14.9 V22 H11 V14.9 A4,4 0 0 1 8,11 Z</StreamGeometry>
    <StreamGeometry x:Key="MicrophoneIcon">M12,2 A3,3 0 0 1 15,5 V11 A3,3 0 0 1 9,11 V5 A3,3 0 0 1 12,2 Z M6,10 H8 V11 A4,4 0 0 0 16,11 V10 H18 V11 A6,6 0 0 1 13,16.9 V20 H16 V22 H8 V20 H11 V16.9 A6,6 0 0 1 6,11 Z</StreamGeometry>
    <!-- Sanduhr für den Übetimer -->
    <StreamGeometry x:Key="TimerIcon">M6,2 H18 V4 H17 V7 C17,9.2 15.4,10.9 13.6,12 C15.4,13.1 17,14.8 17,17 V20 H18 V22 H6 V20 H7 V17 C7,14.8 8.6,13.1 10.4,12 C8.6,10.9 7,9.2 7,7 V4 H6 Z M9,4 V7 C9,8.6 10.4,9.9 12,10.8 C13.6,9.9 15,8.6 15,7 V4 Z M9,20 H15 V17 C15,15.4 13.6,14.1 12,13.2 C10.4,14.1 9,15.4 9,17 Z</StreamGeometry>
    <StreamGeometry x:Key="TempoIcon">M9,2 H15 L20,22 H4 Z M10.5,4 H13.5 L17.3,20 H6.7 Z M11.2,18 L15.5,6.5 L16.6,7 L12.6,18.5 Z</StreamGeometry>

      <!--
        Farben der Bibliothek: Ordner in der Textfarbe des Schemas (weiß bzw. schwarz), virtuelle Stücke leicht
        bläulich, abspielbare Stücke leicht grünlich. Je Schema so gewählt, dass sie gut lesbar bleiben.
      -->
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="LibraryFolderBrush" Color="#000000" />
          <SolidColorBrush x:Key="LibraryPieceBrush" Color="#1D4F8C" />
          <SolidColorBrush x:Key="LibraryFileBrush" Color="#1F6B3A" />
          <!-- Übetimer: ruhig, nichts alarmiert; abgelaufen deutlich als „geschafft“ -->
          <SolidColorBrush x:Key="TimerReadyBrush" Color="#C9CED6" />
          <SolidColorBrush x:Key="TimerRunningBrush" Color="#7CC9C2" />
          <SolidColorBrush x:Key="TimerPausedBrush" Color="#D9DCE1" />
          <SolidColorBrush x:Key="TimerLastBrush" Color="#F0CC8A" />
          <SolidColorBrush x:Key="TimerFinishedBrush" Color="#4CB86A" />
          <SolidColorBrush x:Key="TimerTextBrush" Color="#000000" />
          <!-- Stimmgerät: sauber grün, daneben ruhiges Bernstein -->
          <SolidColorBrush x:Key="TunerInTuneBrush" Color="#4CB86A" />
          <SolidColorBrush x:Key="TunerOffBrush" Color="#F0CC8A" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="LibraryFolderBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="LibraryPieceBrush" Color="#A9CBF5" />
          <SolidColorBrush x:Key="LibraryFileBrush" Color="#B4E6BF" />
          <SolidColorBrush x:Key="TimerReadyBrush" Color="#4A4F57" />
          <SolidColorBrush x:Key="TimerRunningBrush" Color="#2B7A74" />
          <SolidColorBrush x:Key="TimerPausedBrush" Color="#3A3D42" />
          <SolidColorBrush x:Key="TimerLastBrush" Color="#9A6B1F" />
          <SolidColorBrush x:Key="TimerFinishedBrush" Color="#2E9E4F" />
          <SolidColorBrush x:Key="TimerTextBrush" Color="#FFFFFF" />
          <SolidColorBrush x:Key="TunerInTuneBrush" Color="#2E9E4F" />
          <SolidColorBrush x:Key="TunerOffBrush" Color="#9A6B1F" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />

    <!-- Gemeinsame Stile aller Bereiche -->
    <!-- Text in Knöpfen immer mittig, auch wenn der Knopf für den Finger größer ist als die Schrift -->
    <Style Selector="Button, RepeatButton, ToggleButton">
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.flat, ToggleButton.flat">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="4" />
    </Style>
    <!-- Start/Pause der Werkzeuge: gleich groß, Symbol statt Text -->
    <Style Selector="Button.play">
      <Setter Property="Width" Value="64" />
      <Setter Property="Height" Value="48" />
    </Style>
    <Style Selector="Button.play PathIcon">
      <Setter Property="Width" Value="22" />
      <Setter Property="Height" Value="22" />
    </Style>
    <Style Selector="PathIcon.small">
      <Setter Property="Width" Value="14" />
      <Setter Property="Height" Value="14" />
    </Style>
    <Style Selector="TextBlock.hint">
      <Setter Property="Opacity" Value="0.6" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="6,4" />
    </Style>
  </Application.Styles>
</Application>
